# Copy this file to .env.local and fill in real values (never commit .env.local).

# bcrypt hash of the /admin login password. Generate a new one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
# IMPORTANT: escape every "$" in the hash as "\$" — Next.js's env loader does
# shell-style $VAR interpolation, and a bcrypt hash is full of literal "$"
# characters. An unescaped hash gets silently mangled (chunks replaced with
# "" because the interpolated var name doesn't exist) and login will always
# fail with no obvious error. Example: "$2b$12$abc..." -> "\$2b\$12\$abc..."
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
